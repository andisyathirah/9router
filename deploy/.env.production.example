# ============================================================
#  9Router — Production Environment (VPS 4 vCPU / 8 GB)
# ============================================================
# Copy file ini jadi .env.production lalu isi nilai sebenarnya.
#   cp .env.production.example .env.production
#   nano .env.production
#
# JANGAN commit .env.production ke git!
# ============================================================

# --- WAJIB diganti ----------------------------------------------------------

# Secret JWT. Generate dengan: openssl rand -hex 48
JWT_SECRET=GANTI_DENGAN_HASIL_openssl_rand_hex_48

# Password awal login dashboard (username default: admin).
# Login pertama kali akan minta ganti password.
INITIAL_PASSWORD=GantiPasswordIniSekarang!

# Domain publik untuk Caddy (kalau pakai HTTPS).
# Kalau belum punya domain, pakai: DOMAIN=:80
DOMAIN=router.contohanda.com

# --- Recommended ------------------------------------------------------------

DATA_DIR=/app/data
PORT=20128
HOSTNAME=0.0.0.0
NODE_ENV=production

# Salt + secret tambahan. Generate masing-masing: openssl rand -hex 32
API_KEY_SECRET=GANTI_openssl_rand_hex_32
MACHINE_ID_SALT=GANTI_openssl_rand_hex_32

ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true

# Set true kalau diakses lewat HTTPS (Caddy aktif).
AUTH_COOKIE_SECURE=true

# Set true kalau mau wajib API key untuk semua request /v1.
REQUIRE_API_KEY=false

# --- Cloud sync (optional) --------------------------------------------------

# Harus mengarah ke instance ini sendiri (untuk sync scheduler internal).
BASE_URL=http://127.0.0.1:20128
CLOUD_URL=https://9router.com
NEXT_PUBLIC_BASE_URL=https://router.contohanda.com
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# --- Outbound proxy (optional) ----------------------------------------------
# Aktifkan kalau VPS perlu lewat proxy untuk reach provider.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
